# MySQL
MYSQL_DATABASE=crm_db
MYSQL_USER=crm_user
MYSQL_PASSWORD=change_me_strong_mysql_password
MYSQL_ROOT_PASSWORD=change_me_strong_root_password

# Backend datasource
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/crm_db
SPRING_DATASOURCE_USERNAME=crm_user
SPRING_DATASOURCE_PASSWORD=change_me_strong_mysql_password

# Backend app
SERVER_PORT=8081
JWT_SECRET=change_me_to_a_very_long_random_secret_at_least_64_chars
JWT_EXPIRATION_MS=3600000
PUBLIC_API_KEY_PEPPER=change_me_to_a_random_secret_at_least_32_characters
WEBHOOK_SECRET_ENCRYPTION_KEYS=v1:replace_with_base64_encoded_32_byte_key
WEBHOOK_SECRET_ENCRYPTION_KEY_VERSION=v1
WEBHOOK_ALLOW_LOCAL_HTTP=true
WEBHOOK_WORKER_ENABLED=true
WEBHOOK_WORKER_BATCH_SIZE=10
WEBHOOK_WORKER_POLL_INTERVAL_MS=1000
WEBHOOK_WORKER_INITIAL_DELAY_MS=5000
WEBHOOK_STALE_CLAIM_SECONDS=120
WEBHOOK_EVENT_MAXIMUM_ATTEMPTS=5
WEBHOOK_FAILED_SUBSCRIPTION_THRESHOLD=10
# Use a separate 32-byte key in production. Existing installations may
# temporarily reuse the webhook key while rotating to a dedicated key ring.
INTEGRATION_CREDENTIAL_ENCRYPTION_KEYS=v1:replace_with_base64_encoded_32_byte_key
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_RESPONSE_TIMEOUT_SECONDS=10
INTEGRATION_WORKER_ENABLED=true
INTEGRATION_WORKER_BATCH_SIZE=10
INTEGRATION_WORKER_POLL_INTERVAL_MS=1000
INTEGRATION_WORKER_INITIAL_DELAY_MS=5000
INTEGRATION_STALE_CLAIM_SECONDS=120
INTEGRATION_MAXIMUM_ATTEMPTS=6
WORKFLOW_WORKER_ENABLED=true
WORKFLOW_WORKER_BATCH_SIZE=10
WORKFLOW_WORKER_POLL_INTERVAL_MS=1000
WORKFLOW_WORKER_INITIAL_DELAY_MS=5000
WORKFLOW_STALE_CLAIM_SECONDS=120
APP_TIME_ZONE=Africa/Mogadishu
APP_BOOTSTRAP_ADMIN_EMAIL=admin@crm.com
APP_BOOTSTRAP_ADMIN_PASSWORD=change_me_before_public_deployment
TENANT_ENFORCEMENT_ENABLED=true

# Public ports
FRONTEND_PORT=5173
BACKEND_PORT=8081
MYSQL_PORT=3307

# Frontend
VITE_API_BASE_URL=http://localhost:8081/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Email
# Local email testing
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@tadamun.local
MAIL_FROM_NAME=Tadamun
MAIL_REPLY_TO=support@tadamun.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
APP_EMAIL_ENABLED=true
MANAGEMENT_HEALTH_MAIL_ENABLED=false
# Attachments
ATTACHMENT_STORAGE_PATH=/data/attachments
ATTACHMENT_MAX_FILE_SIZE=10MB
ATTACHMENT_MAX_REQUEST_SIZE=11MB
ATTACHMENT_MAX_SIZE_BYTES=10485760
ATTACHMENT_ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg,text/plain,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
# App URLs
APP_FRONTEND_BASE_URL=http://localhost:5173

# Stripe billing - use test-mode values locally
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=

# Local read-only performance testing
LOAD_TEST_ADMIN_EMAIL=admin@crm.com
LOAD_TEST_ADMIN_PASSWORD=replace_with_local_admin_password
LOAD_TEST_VUS=5
LOAD_TEST_DURATION=30s
LOAD_TEST_PAUSE_SECONDS=0.1
# Leave empty to use the first active workspace returned by the API.
LOAD_TEST_ORGANIZATION_ID=
